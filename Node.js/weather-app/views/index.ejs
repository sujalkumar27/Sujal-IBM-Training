<!DOCTYPE html>
<html>

<head>

    <title>Weather App</title>

</head>

<body>

    <h1>Weather App</h1>


    <!-- City input form -->

    <form action="/weather" method="GET">

        <input
            type="text"
            name="city"
            placeholder="Enter city name"
            required
        >

        <button type="submit">
            Get Weather
        </button>

    </form>


    <br>


    <!-- Display error -->

    <% if (error) { %>

        <p>
            <%= error %>
        </p>

    <% } %>


    <!-- Display weather -->

    <% if (weather && !weather.error) { %>

        <h2>
            Weather in <%= weather.city %>
        </h2>

        <p>
            Temperature:
            <%= weather.temperature %> °C
        </p>

        <p>
            Feels Like:
            <%= weather.feelsLike %> °C
        </p>

        <p>
            Humidity:
            <%= weather.humidity %>%
        </p>

        <p>
            Forecast:
            <%= weather.forecast %>
        </p>

    <% } %>


    <!-- Display API error -->

    <% if (weather && weather.error) { %>

        <p>
            <%= weather.error %>
        </p>

    <% } %>


</body>

</html>