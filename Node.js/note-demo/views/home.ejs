<!DOCTYPE html>

<html>

<head>

    <title>Note Keeper</title>

</head>


<body>

    <h1>Note Keeper</h1>


    <div style="display: flex;">

        <% data.forEach(element => { %>


            <!-- UPDATE NOTE -->

            <form action="/update" method="post">

                <!-- MongoDB ID -->
                <input
                    type="hidden"
                    name="noteId"
                    value="<%= element._id %>"
                >


                <!-- Note content -->

                <textarea
                    rows="6"
                    cols="30"
                    placeholder="Type Here..."
                    name="noteContent"
                ><%= element.noteContent %></textarea>


                <br>


                <button type="submit">
                    Update
                </button>

            </form>


            <!-- DELETE NOTE -->

            <form action="/delete" method="post">

                <!-- MongoDB ID -->

                <input
                    type="hidden"
                    name="noteId"
                    value="<%= element._id %>"
                >


                <button
                    type="submit"
                    style="margin: 0px 4px;"
                >
                    &#10005;
                </button>

            </form>


        <% }) %>

    </div>


    <!-- ADD NOTE -->

    <h1>Add Note</h1>


    <form action="/" method="post">

        <textarea
            rows="6"
            cols="30"
            placeholder="Type Here..."
            name="noteContent"
        ></textarea>


        <br>


        <button type="submit">
            Add
        </button>

    </form>


</body>

</html>